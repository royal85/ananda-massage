---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import matter from 'gray-matter';

const { data: c } = matter(readFileSync(resolve(process.cwd(), 'content/over-de-praktijk/index.md'), 'utf-8'));
---
<Layout
  title="Over de praktijk"
  description="Maak kennis met Marjan Bijl van Ananda Massage in Lelystad: haar achtergrond als fysiotherapeute en de betekenis achter de naam Ananda."
>

  <section class="max-w-5xl mx-auto px-6 pt-16 pb-20">
    <p class="text-sm font-medium text-brand-500 uppercase tracking-widest mb-4">Over de praktijk</p>
    <h1 class="text-4xl font-display text-brand-950 mb-12">Hallo, ik ben {c.naam}</h1>

    <div class="grid md:grid-cols-5 gap-12">
      <div class="md:col-span-2">
        <img src={c.foto} alt={c.naam} class="rounded-2xl w-full" />
      </div>
      <div class="md:col-span-3 space-y-6 text-brand-950 leading-relaxed">
        <p class="text-brand-950">{c.intro}</p>
        <div class="p-5 bg-sage-400/10 border border-sage-400/30 rounded-2xl">
          <h2 class="font-display text-brand-950 mb-1">{c.naam_titel}</h2>
          <p class="text-base text-brand-950">{c.naam_tekst}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white border-t border-brand-100">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <h2 class="text-2xl font-display text-brand-950 mb-2">{c.referenties_titel}</h2>
      <p class="text-brand-950 mb-12">{c.referenties_intro}</p>
      <div class="grid sm:grid-cols-2 gap-6">
        {c.referenties.map((ref: { citaat: string }) => (
          <blockquote class="p-6 bg-[#FDFAF7] border border-brand-100 rounded-2xl text-base text-brand-950 leading-relaxed">
            &ldquo;{ref.citaat}&rdquo;
          </blockquote>
        ))}
      </div>
    </div>
  </section>

</Layout>
