---
import { contact } from '../lib/contact';

const links = [
  { href: '/', label: 'Home' },
  { href: '/#tarieven', label: 'Tarieven' },
  { href: '/over-de-praktijk', label: 'Over de praktijk' },
];
const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-brand-100">
  <div class="max-w-5xl mx-auto px-6 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-8 h-8 text-brand-500">
        <path fill="currentColor" d="M16 25 C19.2 20 19.2 15 16 10 C12.8 15 12.8 20 16 25 Z" />
        <path fill="currentColor" transform="rotate(30 16 25)" d="M16 25 C19 20.5 19 16 16 11.5 C13 16 13 20.5 16 25 Z" />
        <path fill="currentColor" transform="rotate(-30 16 25)" d="M16 25 C19 20.5 19 16 16 11.5 C13 16 13 20.5 16 25 Z" />
        <path fill="currentColor" transform="rotate(60 16 25)" d="M16 25 C18.6 21.3 18.6 17.7 16 14 C13.4 17.7 13.4 21.3 16 25 Z" />
        <path fill="currentColor" transform="rotate(-60 16 25)" d="M16 25 C18.6 21.3 18.6 17.7 16 14 C13.4 17.7 13.4 21.3 16 25 Z" />
        <path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.5" d="M5 27.5 Q16 24.5 27 27.5" />
        <path fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.35" d="M9 30 Q16 28.3 23 30" />
      </svg>
      <span class="font-display text-lg text-brand-950 tracking-wide">Ananda Massage</span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      <a
        href="/"
        class={`text-sm transition-colors ${
          currentPath === '/'
            ? 'text-brand-700 font-medium'
            : 'text-brand-950 hover:text-brand-700'
        }`}
      >
        Home
      </a>
      <a href="/#tarieven" class="text-sm text-brand-950 hover:text-brand-700 transition-colors">
        Tarieven
      </a>
      <a
        href="/over-de-praktijk"
        class={`text-sm transition-colors ${
          currentPath === '/over-de-praktijk'
            ? 'text-brand-700 font-medium'
            : 'text-brand-950 hover:text-brand-700'
        }`}
      >
        Over de praktijk
      </a>
      <a
        href={contact.telefoonTel}
        class="inline-flex items-center gap-2 text-sm px-4 py-2 bg-brand-500 text-white font-medium rounded-full hover:bg-brand-600 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-.826 1.68l-1.293.646a11.05 11.05 0 0 0 5.096 5.096l.646-1.293a1.5 1.5 0 0 1 1.68-.826l3.223.716A1.5 1.5 0 0 1 18 13.352V14.5a1.5 1.5 0 0 1-1.5 1.5H15c-7.18 0-13-5.82-13-13V3.5Z" />
        </svg>
        {contact.telefoonDisplay}
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a
        href={contact.telefoonTel}
        aria-label="Bel Ananda Massage"
        class="p-2 text-brand-500"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
          <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-.826 1.68l-1.293.646a11.05 11.05 0 0 0 5.096 5.096l.646-1.293a1.5 1.5 0 0 1 1.68-.826l3.223.716A1.5 1.5 0 0 1 18 13.352V14.5a1.5 1.5 0 0 1-1.5 1.5H15c-7.18 0-13-5.82-13-13V3.5Z" />
        </svg>
      </a>
      <button
        type="button"
        id="menu-toggle"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="p-2 -mr-2 text-brand-900"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-6 h-6">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-6 h-6 hidden">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden border-t border-brand-100 bg-white">
    <div class="max-w-5xl mx-auto px-6 py-4 flex flex-col gap-1">
      {links.map(link => (
        <a
          href={link.href}
          class={`px-3 py-2.5 rounded-lg text-sm transition-colors ${
            currentPath === link.href
              ? 'text-brand-700 font-medium bg-brand-50'
              : 'text-brand-950 hover:text-brand-700 hover:bg-brand-50'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a href={contact.telefoonWhatsapp} target="_blank" rel="noopener noreferrer" class="px-3 py-2.5 rounded-lg text-sm text-brand-950 hover:text-brand-700 hover:bg-brand-50 transition-colors">
        WhatsApp
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const willOpen = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!!willOpen));
  });
</script>
